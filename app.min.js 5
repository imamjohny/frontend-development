const state={data:null,filtered:[],sortKey:"date",sortDir:"desc"}; const $=s=>document.querySelector(s); const money=n=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD",maximumFractionDigits:0}).format(n); const announce=m=>{const e=$("#status");if(e)e.textContent=m}; function renderMetrics(d){ $("#revenueMetric").textContent=money(d.summary.revenue); $("#ordersMetric").textContent=d.summary.orders.toLocaleString(); $("#customersMetric").textContent=d.summary.customers.toLocaleString(); $("#conversionMetric").textContent=d.summary.conversion+"%"; } function renderChart(d){ const max=Math.max(...d.revenue), el=$("#revenueChart"); el.innerHTML=d.revenue.map((v,i)=>`<div class="bar-item"><span class="bar-value">${money(v)}</span><div class="bar" style="height:${Math.max(5,v/max*82)}%"></div><span class="bar-label">${d.months[i]}</span></div>`).join(""); } function renderCategories(d){ $("#categoryList").innerHTML=d.categories.map(c=>`<div class="category-row"><strong>${c.name}</strong><div class="progress" aria-label="${c.name} ${c.share}%"><span style="width:${c.share}%"></span></div><span>${c.share}%</span></div>`).join(""); } function getFiltered(){ const cat=$("#categoryFilter").value, status=$("#statusFilter").value, q=$("#searchInput").value.trim().toLowerCase(); return state.data.records.filter(r=>(cat==="All"||r.category===cat)&&(status==="All"||r.status===status)&&(!q||`${r.id} ${r.customer}`.toLowerCase().includes(q))); } function renderTable(){ let rows=getFiltered(); rows.sort((a,b)=>{let av=a[state.sortKey],bv=b[state.sortKey]; if(state.sortKey==="amount"){av=+av;bv=+bv} return (av>bv?1:av<bv?-1:0)*state.sortDir}); state.filtered=rows; $("#ordersBody").innerHTML=rows.map(r=>`<tr><td>${r.id}</td><td>${r.customer}</td><td>${r.category}</td><td><span class="status-pill ${r.status.toLowerCase()}">${r.status}</span></td><td>${money(r.amount)}</td><td>${new Date(r.date).toLocaleDateString("en-US",{year:"numeric",month:"short",day:"numeric"})}</td></tr>`).join("")||`<tr><td colspan="6">No matching orders found.</td></tr>`; $("#tableSummary").textContent=`Showing ${rows.length} of ${state.data.records.length} orders`; } function bind(){ const menu=$("#menuToggle"),nav=$("#mainNav"); menu.addEventListener("click",()=>{const open=nav.classList.toggle("open");menu.setAttribute("aria-expanded",String(open));}); document.querySelectorAll(".sort").forEach(btn=>btn.addEventListener("click",()=>{const key=btn.dataset.key;if(state.sortKey===key)state.sortDir*=-1;else{state.sortKey=key;state.sortDir=1}renderTable();announce(`Orders sorted by ${key}.`)})); ["#categoryFilter","#statusFilter","#searchInput"].forEach(sel=>$(sel).addEventListener(sel==="#searchInput"?"input":"change",()=>{renderTable();announce("Order filters updated.");})); $("#resetFilters").addEventListener("click",()=>{$("#categoryFilter").value="All";$("#statusFilter").value="All";$("#searchInput").value="";state.sortKey="date";state.sortDir=-1;renderTable();announce("Filters reset.");}); } async function init(){ try{ const res=await fetch("data.json",{cache:"no-cache"}); if(!res.ok)throw new Error("Data request failed"); state.data=await res.json(); renderMetrics(state.data); renderChart(state.data); renderCategories(state.data); renderTable(); bind(); announce("Dashboard data loaded successfully."); }catch(err){console.error(err);announce("Dashboard data could not be loaded. Please run the project through a local web server.");} } init();